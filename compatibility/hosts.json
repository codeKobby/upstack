{
  "schema_version": 1,
  "package": "upstack",
  "version": "1.7.0",
  "universal_install": "npx skills add codeKobby/upstack --all",
  "question_policy": {
    "default": "single-question",
    "multi_question": "use-only-when-native-host-capability-is-verified",
    "planner": "scripts/onboarding.py --host HOST_ID --question-mode native-multi",
    "dispatch": "invoke-callable-native-question-tool-immediately; planner-output-is-not-user-facing",
    "send_only": "question_plan.questions",
    "fallback": "recompute-and-submit-one-question-after-each-answer",
    "native_examples": {"opencode": "question", "claude-code": "AskUserQuestion"}
  },
  "design_policy": {
    "portable_artifacts": [".upstack/design/BRIEF.md", ".upstack/design/WIREFRAME.md", ".upstack/design/DESIGN.md"],
    "stitch": "offer-only-when-verified-callable",
    "remote_writes": "explicit-confirmation-required",
    "fallback": "portable-markdown-wireframe-and-design-contract",
    "planner": "scripts/ui_design.py BRIEF_JSON --mode portable --write"
  },
  "project_tracking": {
    "gate": "scripts/project_state.py --command SUBCOMMAND",
    "identity": ".upstack/PROJECT.json",
    "state": ".upstack/STATE.json",
    "known_project": "load-and-resume; do-not-restart-onboarding",
    "unknown_project": "route-through-onboarding-before-project-command",
    "broad_workspace": "ask-for-explicit-project-path; never-select-child-implicitly",
    "commands": ["upstack", "init", "inventory", "concepts", "focus", "blueprint", "reverse", "build", "stage", "curriculum", "lesson", "hint", "assess", "discover", "choose", "source", "role", "portfolio", "status"]
  },
  "curriculum_policy": {
    "roadmap": "persist-before-lesson-generation",
    "lesson_generation": "explicit-identifier-only",
    "identifiers": ["curriculum-id", "day-number", "day-name", "stage-id", "title", "alias"],
    "locked_behavior": "report-lock-and-unlock-condition; do-not-teach-early",
    "commands": ["curriculum", "lesson IDENTIFIER"]
  },
  "fresh_start_policy": {
    "default_mode": "guided-lesson",
    "planner": "scripts/lesson_plan.py --brief-file BRIEF_JSON --learner-profile-file PROFILE_JSON --mode guided-lesson",
    "modes": ["guided-lesson", "blueprint-then-lessons", "attempt-first", "assisted-slice"],
    "behavior": "teach-one-concept-learner-attempt-approved-verification-feedback-then-unlock",
    "must_not": ["generate-all-lessons", "implement-meaningful-slice-before-learner-attempt", "silently-rewrite-learner-code", "unlock-without-evidence"],
    "portable_artifacts": [".upstack/lessons/LESSON_BLUEPRINT.md", ".upstack/lessons/CURRENT_LESSON.md", ".upstack/lessons/progress.json"],
    "scaffolding": "minimal-confirmed-foundation-only; meaningful-feature-help-is-bounded-and-reviewable"
  },
  "interview_policy": {
    "planner": "scripts/interview_prep.py --job-file JOB_JSON --sources-file SOURCES_JSON --skill-profile-file PROFILE_JSON --mode plan",
    "requirements_first": true,
    "skill_profile": "self-report-plus-small-diagnostics; keep-reported-and-demonstrated-levels-separate",
    "evidence_classes": ["verified_requirement", "official_company_signal", "high_confidence_public_pattern", "plausible_requirement_derived", "practice_only"],
    "question_claim": "patterns-are-not-guarantees",
    "feedback": "preserve-attempt-explain-first-gap-tradeoffs-verification-and-transfer",
    "output_modes": ["inline", "markdown", "both"]
  },
  "companion_installation": {
    "planner": "scripts/install_video_companion.py --host HOST_ID --json",
    "install_requires": "explicit-learner-confirmation",
    "marketplace_identifier": "codeKobby.upstack-video-companion",
    "fallback": ".upstack/sources/video-map.md and .upstack/sources/video-map.json",
    "never": ["silent-install", "claim-installed-without-host-evidence", "overwrite-source-code"]
  },
  "hosts": [
    {
      "id": "claude-code",
      "display_name": "Claude Code",
      "tier": "A",
      "project_paths": [".claude/skills/<skill>/SKILL.md"],
      "global_paths": ["~/.claude/skills/<skill>/SKILL.md"],
      "invocation": ["/upstack", "automatic"],
      "install": ["npx skills add codeKobby/upstack --all -a claude-code"]
    },
    {
      "id": "codex",
      "display_name": "OpenAI Codex CLI",
      "tier": "A",
      "project_paths": [".agents/skills/<skill>/SKILL.md"],
      "global_paths": ["~/.agents/skills/<skill>/SKILL.md"],
      "invocation": ["skill picker", "explicit skill use"],
      "install": ["npx skills add codeKobby/upstack --all -a codex"],
      "metadata": ["agents/openai.yaml"]
    },
    {
      "id": "cline",
      "display_name": "Cline",
      "tier": "A",
      "project_paths": [".cline/skills/<skill>/SKILL.md", ".clinerules/skills/<skill>/SKILL.md"],
      "global_paths": ["~/.cline/skills/<skill>/SKILL.md"],
      "invocation": ["slash command", "automatic use_skill"],
      "install": ["npx skills add codeKobby/upstack --all -a cline"]
    },
    {
      "id": "opencode",
      "display_name": "OpenCode",
      "tier": "A",
      "project_paths": [".opencode/skills/<skill>/SKILL.md", ".agents/skills/<skill>/SKILL.md"],
      "global_paths": ["~/.config/opencode/skills/<skill>/SKILL.md"],
      "invocation": ["native skill tool", "slash UI"],
      "question_ui": {
        "tool": "question",
        "supports_multiple_questions": true,
        "supports_custom_answers": true,
        "conditional_chaining": "recompute-between-submissions",
        "upstack_planner": "scripts/onboarding.py --host HOST_ID --question-mode native-multi"
      },
      "install": ["npx skills add codeKobby/upstack --all -a opencode"]
    },
    {
      "id": "antigravity",
      "display_name": "Google Antigravity",
      "tier": "A",
      "project_paths": [".agents/skills/<skill>/SKILL.md", ".agent/skills/<skill>/SKILL.md"],
      "global_paths": ["~/.gemini/config/skills/<skill>/SKILL.md"],
      "invocation": ["automatic", "explicit skill mention"],
      "install": ["npx skills add codeKobby/upstack --all -a antigravity"]
    },
    {
      "id": "copilot-vscode",
      "display_name": "GitHub Copilot in VS Code",
      "tier": "A",
      "project_paths": [".github/skills/<skill>/SKILL.md"],
      "global_paths": ["configured chat.agentSkillsLocations"],
      "invocation": ["/ skill menu", "automatic"],
      "install": ["copy the skill folder to .github/skills"]
    },
    {
      "id": "cursor",
      "display_name": "Cursor",
      "tier": "B",
      "project_paths": ["host-specific; verify current release"],
      "global_paths": ["host-specific; verify current release"],
      "invocation": ["host skill UI or slash command"],
      "install": ["npx skills add codeKobby/upstack --all -a cursor"]
    },
    {
      "id": "factory",
      "display_name": "Factory Droid",
      "tier": "B",
      "project_paths": ["host-specific; verify current release"],
      "global_paths": ["host-specific; verify current release"],
      "invocation": ["host skill UI"],
      "install": ["npx skills add codeKobby/upstack --all -a factory"]
    },
    {
      "id": "kiro",
      "display_name": "Kiro",
      "tier": "B",
      "project_paths": ["host-specific; verify current release"],
      "global_paths": ["host-specific; verify current release"],
      "invocation": ["host skill UI"],
      "install": ["npx skills add codeKobby/upstack --all -a kiro"]
    },
    {
      "id": "slate",
      "display_name": "Slate",
      "tier": "B",
      "project_paths": ["host-specific; verify current release"],
      "global_paths": ["host-specific; verify current release"],
      "invocation": ["host skill UI"],
      "install": ["npx skills add codeKobby/upstack --all -a slate"]
    },
    {
      "id": "hermes",
      "display_name": "Hermes",
      "tier": "B",
      "project_paths": ["host-specific; verify current release"],
      "global_paths": ["host-specific; verify current release"],
      "invocation": ["host skill UI"],
      "install": ["npx skills add codeKobby/upstack --all -a hermes"]
    },
    {
      "id": "openclaw",
      "display_name": "OpenClaw",
      "tier": "C",
      "project_paths": ["bridge-specific"],
      "global_paths": ["bridge-specific"],
      "invocation": ["conversational bridge", "spawned coding-agent session"],
      "install": ["use the OpenClaw bridge or a supported coding agent"]
    },
    {
      "id": "gbrain",
      "display_name": "GBrain",
      "tier": "C",
      "project_paths": ["provider-specific"],
      "global_paths": ["provider-specific"],
      "invocation": ["provider-specific"],
      "install": ["optional code-intelligence integration"]
    }
  ]
}
